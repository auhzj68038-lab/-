# このファイルを .env にコピーして書き換える（.env は GitHub に上げない）
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# VOICEVOX
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3

# VTube Studio の LipSync 入力にしている仮想オーディオデバイス名（一部一致でOK）
VIRTUAL_AUDIO_DEVICE=CABLE Input

# OBS（ツール > WebSocketサーバー設定 で有効化してパスワードを入れる）
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# 配信スケジュール（PCのローカル時刻）
SHOW_START=22:00
SHOW_END=23:00
# 何分前に締めに入るか
CLOSING_MINUTES_BEFORE=2
# コメントが来ない時、何秒で雑談を始めるか
IDLE_SECONDS=40
